input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:lalt_lshift_toggle,compose:ralt,ctrl:nocaps"
        }
    }
    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
    }
    mouse
    trackpoint
    tablet { map-to-output "eDP-1"; }
    touch { map-to-output "eDP-1"; }
}
// Generated by Home Manager from host-specific display settings.
include "~/.config/niri-host/outputs.kdl"

layout {
    focus-ring {
        width 4
        active-color "#ffffff"
        inactive-color "#505050"
    }
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
    }
    preset-column-widths {
        proportion 0.333333
        proportion 0.500000
        proportion 0.666667
    }
    default-column-width { proportion 0.500000; }
    gaps 16
    struts
    center-focused-column "never"
    // Transparent so the Ambxst wallpaper backdrop shows through.
    background-color "transparent"
}
environment {
    // Keep the session environment explicit for Qt and Electron applications.
    XDG_MENU_PREFIX "plasma-"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "kde"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
// Ambxst generates this file from ~/.config/ambxst/config and binds.json.
include "~/.local/share/ambxst/niri.kdl"
spawn-at-startup "ambxst"

cursor
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
hotkey-overlay { skip-at-startup; }
animations {
    workspace-switch
    horizontal-view-movement
    window-open
    config-notification-open-close
}
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Move the focused window between the floating and the tiling layout.
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Bind for running programs
    Mod+T { spawn "alacritty"; }
    Mod+D { spawn-sh "vicinae open"; }
    Mod+Q repeat=false { close-window; }

    // My favorite base hotkeys
    Mod+Left            { focus-column-left; }
    Mod+Right           { focus-column-right; }
    Mod+Down            { focus-workspace-down; }
    Mod+Up              { focus-workspace-up;}
    Mod+Ctrl+Left       { move-column-left; }
    Mod+Ctrl+Right      { move-column-right; }
    Mod+Ctrl+Down       { move-column-to-workspace-down; }
    Mod+Ctrl+Up         { move-column-to-workspace-up; }
    Mod+Shift+Ctrl+Up          { move-workspace-to-monitor-up; }
    Mod+Shift+Ctrl+Down        { move-workspace-to-monitor-down; }
    Mod+Shift+Ctrl+Left        { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Right       { move-workspace-to-monitor-right; }
    Mod+Shift+Left      { focus-monitor-left; }
    Mod+Shift+Down      { focus-monitor-down; }
    Mod+Shift+Up        { focus-monitor-up; }
    Mod+Shift+Right     { focus-monitor-right; }
    Mod+Ctrl+Page_Down  { move-workspace-down; }
    Mod+Ctrl+Page_Up    { move-workspace-up; }

    // Home End
    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End { move-column-to-last; }

    // And etc
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }
    Mod+O { toggle-overview; }

}

window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 20

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

debug {
  // Allows notification actions and window activation from desktop shells.
  honor-xdg-activation-with-invalid-serial
}
