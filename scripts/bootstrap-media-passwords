#!/usr/bin/env python3
"""Create missing media-service administrator passwords in the private SOPS file."""

import json
import os
import secrets
import shutil
import subprocess
import sys
from pathlib import Path


keys = [
    ("jellyfin-admin-password", "Jellyfin administrator"),
    ("bindery-admin-password", "Bindery administrator"),
    ("qbittorrent-webui-password", "qBittorrent Web UI administrator"),
    ("jackett-admin-password", "Jackett administrator"),
    ("streamline-admin-password", "Streamline administrator"),
]
repo = Path(__file__).resolve().parents[1]
private_dir = Path(
    os.environ.get("PRIVATE_FLAKE_DIR", repo.parent / "outworld-nixos-private")
)
sops_file = private_dir / "secrets" / "private.yaml"
sops = ["sops"] if shutil.which("sops") else ["nix", "run", "nixpkgs#sops", "--"]


def run(args: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(args, check=True, text=True, capture_output=True, **kwargs)
    except subprocess.CalledProcessError:
        raise SystemExit("SOPS failed; no password values were printed.") from None


if not sops_file.is_file():
    sys.exit(f"SOPS file not found: {sops_file}")

decrypted = run(sops + ["--decrypt", "--output-type", "json", str(sops_file)])
data = json.loads(decrypted.stdout)
media = data.setdefault("media", {})
created = []
existing = []

for key, label in keys:
    if media.get(key):
        existing.append(label)
        continue
    password = secrets.token_urlsafe(36)
    run(
        sops
        + [
            "set",
            str(sops_file),
            f'["media"]["{key}"]',
            "--value-stdin",
        ],
        input=json.dumps(password),
    )
    media[key] = password
    created.append(label)

for label in created:
    print(f"Created SOPS password: {label}")
for label in existing:
    print(f"Kept existing SOPS password: {label}")
print(f"Secret file: {sops_file}")
print("Passwords were not displayed. Set each service's password to its matching SOPS value.")
