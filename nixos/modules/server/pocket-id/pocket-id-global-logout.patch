diff --git c/frontend/src/lib/services/webauthn-service.ts w/frontend/src/lib/services/webauthn-service.ts
index b7250ff..e95b2ec 100644
--- c/frontend/src/lib/services/webauthn-service.ts
+++ w/frontend/src/lib/services/webauthn-service.ts
@@ -19 +19,26 @@ class WebAuthnService extends APIService {
-		await this.api.post(`/webauthn/logout`);
+		const { frontchannelLogoutURLs } = (await this.api.post(`/webauthn/logout`)).data as {
+			frontchannelLogoutURLs: string[];
+		};
+		if (frontchannelLogoutURLs.length === 1) {
+			window.location.assign(frontchannelLogoutURLs[0]);
+			return;
+		}
+		await Promise.all(
+			frontchannelLogoutURLs.map(
+				(url) =>
+					new Promise<void>((resolve) => {
+						const iframe = document.createElement('iframe');
+						iframe.hidden = true;
+						iframe.onload = iframe.onerror = () => {
+							iframe.remove();
+							resolve();
+						};
+						document.body.append(iframe);
+						iframe.src = url;
+						setTimeout(() => {
+							iframe.remove();
+							resolve();
+						}, 5000);
+					})
+			)
+		);
